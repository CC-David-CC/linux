[Unit]
Description=Verify the firewall for the WebOS guest network worker
Before=webos-viewer-wire.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=@PYTHON@ -I -B @RELEASE@/serve-viewer-wire.py guard
TimeoutStartSec=30
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN
